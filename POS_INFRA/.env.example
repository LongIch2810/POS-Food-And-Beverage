# Database configuration
POSTGRES_USER=pos_local
POSTGRES_PASSWORD=pos_local_secret
POSTGRES_DB=pos_local

# API configuration (optional overrides)
PORT=3000
PUBLIC_ORIGIN=http://localhost:5173
JWT_SECRET=pos_local_dev_jwt_secret_32_bytes_long_key!
CSRF_SECRET=pos_local_dev_csrf_secret_32_bytes_long_key!
SEPAY_ENV=test
# Tối thiểu 32 byte, tự tạo ngẫu nhiên; để trống thì webhook SePay trả 503 (không dùng giá trị mẫu).
SEPAY_WEBHOOK_SECRET=

# Bootstrap Admin (optional overrides)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_FULL_NAME=Quan tri he thong
BOOTSTRAP_ADMIN_PASSWORD=Admin@Local2026!
